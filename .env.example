# Copy to .env and adjust. Never commit .env.

# Postgres
POSTGRES_DB=vaultflow
POSTGRES_USER=vaultflow
POSTGRES_PASSWORD=vaultflow
POSTGRES_PORT=5432
DATABASE_URL=postgres://vaultflow:vaultflow@localhost:5432/vaultflow

# Object storage: local disk by default; set STORAGE_BACKEND=s3 for MinIO/S3
STORAGE_BACKEND=local
STORAGE_ROOT=.storage
MAX_CHUNK_SIZE=8388608
# MinIO locally, any S3-compatible service in production
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=vaultflow
S3_SECRET_KEY=vaultflow-secret
S3_BUCKET=vaultflow
S3_CONSOLE_PORT=9001

# API
API_PORT=8080
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Argon2id cost for password hashing (OWASP minimum shown; raise in prod)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
# Comma-separated browser origins allowed by CORS (`*` for development)
CORS_ALLOWED_ORIGINS=*
# Set to prod to refuse the default JWT_SECRET
VAULTFLOW_ENV=dev
UPLOAD_SESSION_TTL_HOURS=24

# Flutter client (passed via --dart-define or scripts/run_app.sh)
VAULTFLOW_API_BASE_URL=http://localhost:8080

# Browser download links and the SSE connection lifetime
DOWNLOAD_LINK_TTL_MINUTES=5
EVENTS_MAX_AGE_MINUTES=5

# Abuse controls and limits (see docs/OPERATIONS.md)
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10737418240
TRUST_PROXY=false
SHUTDOWN_GRACE_SECONDS=20

# Observability
LOG_FORMAT=text            # text | json
METRICS_TOKEN=             # set to enable GET /metrics
SENTRY_DSN=                # set to report unhandled errors
SENTRY_ENVIRONMENT=prod
